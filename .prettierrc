{
  "arrowParens": "always",
  "bracketSameLine": true,
  "bracketSpacing": true,
  "printWidth": 80,
  "proseWrap": "preserve",
  "overrides": [
    {
      "files": ["**/*.md", "**/*.mdx"],
      "options": {
        "printWidth": 200,
        "proseWrap": "preserve"
      }
    }
  ],
  "singleQuote": false,
  "trailingComma": "all",
  "tabWidth": 2,
  "semi": true
}
